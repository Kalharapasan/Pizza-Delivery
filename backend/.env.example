# Copy this file to .env and adjust as needed.
# Either set the individual MYSQL_* vars (used to build the connection string)...
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=pizza_delivery

# ...or override the full connection string directly (takes priority if set).
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pizza_delivery

# For quick local testing without MySQL, uncomment:
# DATABASE_URL=sqlite:///./pizza_delivery.db

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
